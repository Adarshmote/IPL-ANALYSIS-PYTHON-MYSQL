        "id": "MB2mvHTzdOEh"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate the 90th percentile along with Threshold value\n",
        "\n",
        "high_score_threshold = np.percentile(\n",
        "    match_run_summary[\"total_runs\"],\n",
        "    90\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"High-scoring threshold:\",\n",
        "    high_score_threshold\n",
        ")\n",
        "\n",
        "# Check for total runs\n",
        "\n",
        "high_scoring_matches = (\n",
        "    match_run_summary[\n",
        "        match_run_summary[\"total_runs\"] >= high_score_threshold\n",
        "    ]\n",
        "    .sort_values(\n",
        "        \"total_runs\",\n",
        "        ascending=False\n",
        "    )\n",
        ")\n",
        "\n",
        "high_scoring_matches"
      ],
