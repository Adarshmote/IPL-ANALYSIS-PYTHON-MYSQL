        "query =  \"\"\"\n",
        "    SELECT\n",
        "        match_id,\n",
        "        SUM(bowler_runs) AS total_runs\n",
        "    FROM deliveries\n",
        "    GROUP BY match_id\n",
        "    ORDER BY total_runs DESC\n",
        "    LIMIT 10\n",
        "    \"\"\"\n",
