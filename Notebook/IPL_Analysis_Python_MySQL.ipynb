    {
      "cell_type": "markdown",
      "source": [
        "27.3. Load All Data into Tables"
      ],
      "metadata": {
        "id": "z6DwujNAf_Zc"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "## Player Table Values Insert\n",
        "\n",
        "player_insert = \"\"\"\n",
        "INSERT INTO players\n",
        "(player_id, player_name, team, role)\n",
        "VALUES (%s, %s, %s, %s)\n",
        "\"\"\"\n",
        "\n",
        "#Convert DataFrame:\n",
        "player_data = list(\n",
        "    players_clean[\n",
        "        [\n",
        "            \"player_id\",\n",
        "            \"player_name\",\n",
        "            \"team\",\n",
        "            \"role\"\n",
        "        ]\n",
        "    ].itertuples(index=False, name=None)\n",
        ")\n",
        "\n",
        "# Insert\n",
        "cursor.executemany(\n",
        "    player_insert,\n",
        "    player_data\n",
        ")\n",
        "\n",
        "conn.commit()\n",
        "\n",
        "print(\"Players loaded:\", cursor.rowcount)"
      ],
      "metadata": {
