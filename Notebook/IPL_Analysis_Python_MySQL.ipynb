    {
      "cell_type": "markdown",
      "source": [
        "7.3 Business Rule For Conflicting Matches"
      ],
      "metadata": {
        "id": "S8rk3SgN91Za"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Create Flag\n",
        "matches_clean[\"data_quality_flag\"] = \"Valid\"\n",
        "\n",
        "# Operations to Flag a Winner\n",
        "matches_clean.loc[\n",
        "    matches_clean[\"match_id\"].isin(conflicting_match_ids.index),\n",
        "    \"data_quality_flag\"\n",
        "] = \"Conflicting Duplicate\"\n",
        "\n",
        "matches_clean.loc[\n",
        "    matches_clean[\"match_id\"].isin(conflicting_match_ids.index),\n",
        "    \"winner\"\n",
        "] = np.nan\n",
        "\n",
        "# Remove Duplicates\n",
        "matches_clean = (\n",
        "    matches_clean\n",
        "    .drop_duplicates(subset=[\"match_id\"], keep=\"first\")\n",
        ")"
      ],
      "metadata": {
        "id": "owHdZ7XU9z82"
      },
      "execution_count": 78,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "7.4 Match Status"
      ],
      "metadata": {
        "id": "UeOoqfoK-e1O"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Match Status with Flag help\n",
        "matches_clean[\"match_status\"] = np.where(\n",
        "    matches_clean[\"data_quality_flag\"] == \"Conflicting Duplicate\",\n",
        "    \"Data Issue\",\n",
        "    np.where(\n",
        "        matches_clean[\"winner\"].isna(),\n",
        "        \"No Result\",\n",
        "        \"Completed\"\n",
        "    )\n",
        ")\n",
        "\n",
        "# Cheack for Status\n",
        "matches_clean[\"match_status\"].value_counts()"
      ],
