      ]
    },
    {
      "cell_type": "code",
      "source": [
        "## Match Table Values Insert\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. Remove duplicate match IDs\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "matches_clean = matches_clean.drop_duplicates(\n",
        "    subset=[\"match_id\"],\n",
        "    keep=\"first\"\n",
        ")\n",
        "\n",
        "print(\"Rows after removing duplicates:\", len(matches_clean))\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. INSERT query\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "match_insert = \"\"\"\n",
        "INSERT INTO matches\n",
        "(\n",
        "    match_id,\n",
        "    season,\n",
        "    team1,\n",
        "    team2,\n",
        "    venue,\n",
        "    winner,\n",
        "    match_date,\n",
        "    match_year,\n",
        "    data_quality_flag,\n",
        "    match_status,\n",
        "    season_date_mismatch\n",
        ")\n",
        "VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. Select required columns\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "match_df = matches_clean[\n",
        "    [\n",
        "        \"match_id\",\n",
        "        \"season\",\n",
        "        \"team1\",\n",
        "        \"team2\",\n",
        "        \"venue\",\n",
        "        \"winner\",\n",
        "        \"match_date\",\n",
        "        \"match_year\",\n",
        "        \"data_quality_flag\",\n",
        "        \"match_status\",\n",
        "        \"season_date_mismatch\"\n",
        "    ]\n",
        "].copy()\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. Convert NaN / NaT → None\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "match_df = match_df.astype(object).where(\n",
        "    pd.notna(match_df),\n",
        "    None\n",
        ")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 5. Convert rows to tuples\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "match_data = list(\n",
        "    match_df.itertuples(\n",
        "        index=False,\n",
        "        name=None\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 6. Insert into MySQL\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# Temporarily disable foreign key checks\n",
        "cursor.execute(\"SET FOREIGN_KEY_CHECKS = 0\")\n",
        "\n",
        "# Clear child table (deliveries) first, then parent table (matches)\n",
        "cursor.execute(\"TRUNCATE TABLE deliveries\")\n",
        "cursor.execute(\"TRUNCATE TABLE matches\")\n",
        "conn.commit()\n",
        "\n",
        "# Re-enable foreign key checks\n",
        "cursor.execute(\"SET FOREIGN_KEY_CHECKS = 1\")\n",
        "\n",
        "cursor.executemany(\n",
        "    match_insert,\n",
        "    match_data\n",
        ")\n",
        "\n",
        "conn.commit()\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 7. Result\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"Matches loaded:\", cursor.rowcount)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
