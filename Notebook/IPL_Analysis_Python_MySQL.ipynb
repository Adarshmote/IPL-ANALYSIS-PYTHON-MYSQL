    {
      "cell_type": "code",
      "source": [
        "wickets_per_match = (\n",
        "    deliveries_clean\n",
        "    .groupby(\"match_id\")[\"is_wicket\"]\n",
        "    .sum()\n",
        "    .reset_index(name=\"total_wickets\")\n",
