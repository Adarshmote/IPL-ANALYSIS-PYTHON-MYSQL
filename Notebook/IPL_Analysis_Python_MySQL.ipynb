    {
      "cell_type": "markdown",
      "source": [
        "10. Delivery Primary Key"
      ],
      "metadata": {
        "id": "bHT1PBy1D09z"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Check for Primary Key\n",
        "delivery_key = [\n",
        "    \"match_id\",\n",
        "    \"inning\",\n",
        "    \"over\",\n",
        "    \"ball\"\n",
        "]\n",
        "\n",
        "deliveries_clean.duplicated(\n",
        "    subset=delivery_key\n",
        ").sum()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "g2cugWtvD23T",
        "outputId": "d867ba31-08f3-4678-e10e-99892c26c88a"
