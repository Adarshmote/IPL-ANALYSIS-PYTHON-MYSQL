    },
    {
      "cell_type": "markdown",
      "source": [
        "9. Referential Integrity Promotion"
      ],
      "metadata": {
        "id": "zWOJPgCTCai5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Check for Duplicates Values\n",
        "valid_match_ids = set(matches_clean[\"match_id\"])\n",
        "\n",
        "invalid_delivery_rows = deliveries_clean[\n",
        "    ~deliveries_clean[\"match_id\"].isin(valid_match_ids)\n",
        "]\n",
        "\n",
        "print(\"Invalid delivery rows:\",\n",
        "      len(invalid_delivery_rows))\n",
        "\n",
        "# Drop Duplicates\n",
        "deliveries_clean = deliveries_clean[\n",
        "    deliveries_clean[\"match_id\"].isin(valid_match_ids)\n",
        "].copy()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "FMuOYAWnCdut",
        "outputId": "9d9d1f62-7809-41b6-eea4-e8dfff28d8ae"
      },
      "execution_count": 83,
