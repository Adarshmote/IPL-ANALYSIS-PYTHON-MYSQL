    {
      "cell_type": "markdown",
      "source": [
        "6.2 Clean Player Text"
      ],
      "metadata": {
        "id": "w4UBCkkx7psr"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Clean Player Text\n",
        "players_clean[\"player_name\"] = (\n",
        "    players_clean[\"player_name\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        ")\n",
        "\n",
        "players_clean[\"team\"] = (\n",
        "    players_clean[\"team\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.upper()\n",
        ")\n",
        "\n",
        "players_clean[\"role\"] = (\n",
        "    players_clean[\"role\"]\n",
        "    .fillna(\"Unknown\")\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        ")\n",
        "\n",
        "# Verify Null\n",
        "players_clean.isnull().sum()"
      ],
