    {
      "cell_type": "markdown",
      "source": [
        "6.1 Removal of duplicates"
      ],
      "metadata": {
        "id": "Ca4xNGlijvhq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "players_clean = players.copy()\n",
        "\n",
        "before = len(players_clean)\n",
        "\n",
        "players_clean = players_clean.drop_duplicates()\n",
        "\n",
        "after = len(players_clean)\n",
        "\n",
        "print(\"Rows before:\", before)\n",
        "print(\"Rows after:\", after)\n",
        "print(\"Duplicates removed:\", before - after)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "_86rBZgOjmLi",
        "outputId": "2c62665f-3836-4901-a365-7505ec270cc2"
