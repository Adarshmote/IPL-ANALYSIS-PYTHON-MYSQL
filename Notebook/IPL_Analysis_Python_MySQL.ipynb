    {
      "cell_type": "code",
      "source": [
        "# Indentify Conflicts with match_id\n",
        "conflicting_match_ids = (\n",
        "    duplicate_match_ids\n",
        "    .groupby(\"match_id\")[\"winner\"]\n",
        "    .nunique()\n",
        ")\n",
        "\n",
        "conflicting_match_ids = conflicting_match_ids[\n",
        "    conflicting_match_ids > 1\n",
        "]\n",
        "\n",
        "conflicting_match_ids"
      ],
