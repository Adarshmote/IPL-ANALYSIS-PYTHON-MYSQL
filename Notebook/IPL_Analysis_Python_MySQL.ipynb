    {
      "cell_type": "markdown",
      "source": [
        "28.4 Average Runs Per Match"
      ],
      "metadata": {
        "id": "d33Do1YQoAOw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "query =  \"\"\"\n",
        "    SELECT\n",
        "        ROUND(\n",
        "            AVG(total_runs),\n",
        "            2\n",
        "        ) AS average_runs_per_match\n",
        "    FROM (\n",
        "        SELECT\n",
        "            match_id,\n",
        "            SUM(bowler_runs) AS total_runs\n",
        "        FROM deliveries\n",
        "        GROUP BY match_id\n",
        "    ) AS match_scores\n",
        "    \"\"\"\n",
