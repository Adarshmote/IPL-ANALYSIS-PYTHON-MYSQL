    {
      "cell_type": "code",
      "source": [
        "matches_clean[\"match_date\"] = pd.to_datetime(\n",
        "    matches_clean[\"match_date\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "matches_clean[\"match_year\"] = (\n",
