      "cell_type": "markdown",
      "source": [
        "28.5 Average Runs By Season"
      ],
      "metadata": {
        "id": "qdKJC5KPotwr"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "query = \"\"\"\n",
        "    SELECT\n",
        "        m.season,\n",
        "        ROUND(AVG(match_scores.total_runs), 2)\n",
        "            AS average_runs\n",
        "    FROM matches m\n",
        "    JOIN (\n",
        "        SELECT\n",
        "            match_id,\n",
        "            SUM(bowler_runs) AS total_runs\n",
        "        FROM deliveries\n",
        "        GROUP BY match_id\n",
        "    ) match_scores\n",
        "    ON m.match_id = match_scores.match_id\n",
        "    GROUP BY m.season\n",
        "    ORDER BY m.season\n",
        "    \"\"\"\n",
        "\n",
        "avg_runs_by_season = pd.read_sql(query,conn)\n",
        "avg_runs_by_season"
      ],
