        ")\n",
        "\n",
        "# Indentify Dirty Season\n",
        "matches_clean[\"season_date_mismatch\"] = (\n",
        "    matches_clean[\"season\"] != matches_clean[\"match_year\"]\n",
        ")\n",
        "\n",
        "# Check\n",
        "matches_clean[\"season_date_mismatch\"].value_counts()"
