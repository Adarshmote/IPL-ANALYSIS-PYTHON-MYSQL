    {
      "cell_type": "markdown",
      "source": [
        "27.2 Table Creations"
      ],
      "metadata": {
        "id": "NPphCORce3yI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "create_players_table = \"\"\"\n",
        "CREATE TABLE IF NOT EXISTS players (\n",
        "    player_id INT PRIMARY KEY,\n",
        "    player_name VARCHAR(100) NOT NULL,\n",
        "    team VARCHAR(20) NOT NULL,\n",
        "    role VARCHAR(50) NOT NULL\n",
        ")\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(create_players_table)\n",
        "conn.commit()"
      ],
      "metadata": {
        "id": "odSyyITOe6RG"
      },
      "execution_count": 125,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "create_matches_table = \"\"\"\n",
        "CREATE TABLE IF NOT EXISTS matches (\n",
        "    match_id INT PRIMARY KEY,\n",
        "    season INT NOT NULL,\n",
        "    team1 VARCHAR(20) NOT NULL,\n",
        "    team2 VARCHAR(20) NOT NULL,\n",
        "    venue VARCHAR(100) NOT NULL,\n",
        "    winner VARCHAR(20),\n",
        "    match_date DATE,\n",
        "    match_year INT,\n",
        "    data_quality_flag VARCHAR(50),\n",
        "    match_status VARCHAR(30),\n",
        "    season_date_mismatch BOOLEAN\n",
        ")\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(create_matches_table)\n",
        "conn.commit()"
      ],
      "metadata": {
        "id": "sceu0G8vfYzk"
      },
      "execution_count": 126,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "create_deliveries_table = \"\"\"\n",
        "CREATE TABLE IF NOT EXISTS deliveries (\n",
        "    match_id INT NOT NULL,\n",
        "    inning INT NOT NULL,\n",
        "    `over` INT NOT NULL,\n",
        "    ball INT NOT NULL,\n",
        "    batsman_runs DECIMAL(5,2) NOT NULL,\n",
        "    bowler_runs DECIMAL(5,2) NOT NULL,\n",
        "    is_wicket BOOLEAN NOT NULL,\n",
        "\n",
        "    PRIMARY KEY (\n",
        "        match_id,\n",
        "        inning,\n",
        "        `over`,\n",
        "        ball\n",
        "    ),\n",
        "\n",
        "    CONSTRAINT fk_delivery_match\n",
        "        FOREIGN KEY (match_id)\n",
        "        REFERENCES matches(match_id)\n",
        ")\n",
        "\"\"\"\n",
        "\n",
        "cursor.execute(create_deliveries_table)\n",
        "conn.commit()"
      ],
      "metadata": {
        "id": "lfbl-sfpfmyo"
      },
      "execution_count": 127,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "cursor.execute(\"SHOW TABLES\")\n",
        "\n",
