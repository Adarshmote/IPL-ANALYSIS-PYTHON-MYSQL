    {
      "cell_type": "markdown",
      "source": [
        "**8. ETL: DELIVERIES**"
      ],
      "metadata": {
        "id": "izI5oT3m_uLx"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "8.1 Copy and Drop Duplicates"
      ],
      "metadata": {
        "id": "fI0wsoEM_1bM"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Create Copy of Deliveries\n",
        "deliveries_clean = deliveries.copy()\n",
        "\n",
        "# Drop Duplicates\n",
        "before = len(deliveries_clean)\n",
        "\n",
        "deliveries_clean = deliveries_clean.drop_duplicates()\n",
        "\n",
        "after = len(deliveries_clean)\n",
        "\n",
        "print(\"Before:\", before)\n",
        "print(\"After:\", after)\n",
        "print(\"Removed:\", before - after)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "IH5tG7lJ_xV2",
        "outputId": "b6ffa6c2-1002-4dfd-fcc9-13145bf9d327"
      },
      "execution_count": 82,
      "outputs": [
