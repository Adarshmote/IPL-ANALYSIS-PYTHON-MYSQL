    {
      "cell_type": "markdown",
      "source": [
        "11. Handle Conflicting Delivery Records"
      ],
      "metadata": {
        "id": "_k0jxjuXETo3"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "11.1 Identify conflicting keys:"
      ],
      "metadata": {
        "id": "1k5hAiXvEcfb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Identify Conflicts\n",
        "key_variation = (\n",
        "    deliveries_clean\n",
        "    .groupby(delivery_key)\n",
        "    .nunique()\n",
        ")\n",
        "\n",
        "conflicting_delivery_keys = key_variation[\n",
        "    (key_variation > 1).any(axis=1)\n",
        "].index\n",
        "\n",
        "# Audit information\n",
        "print(\n",
        "    \"Conflicting delivery keys:\",\n",
        "    len(conflicting_delivery_keys)\n",
        ")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "2WyUIXoCEYia",
        "outputId": "8d29f912-e981-479b-9512-a0fcf9806dfa"
      },
      "execution_count": 85,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Conflicting delivery keys: 11\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "11.2 Drop Conflicting Keys"
      ],
      "metadata": {
        "id": "O8bTveUkE38d"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Drop Conflicting Keys\n",
        "delivery_index = pd.MultiIndex.from_frame(\n",
        "    deliveries_clean[delivery_key]\n",
        ")\n",
        "\n",
        "conflict_index = pd.MultiIndex.from_tuples(\n",
        "    conflicting_delivery_keys\n",
        ")\n",
        "\n",
        "conflict_mask = delivery_index.isin(conflict_index)\n",
        "\n",
        "deliveries_clean = deliveries_clean[\n",
        "    ~conflict_mask\n",
        "].copy()\n",
        "\n",
        "# Check for conflicts\n",
        "deliveries_clean.duplicated(\n",
        "    subset=delivery_key\n",
        ").sum()\n",
        "\n",
        "deliveries_clean"
      ],
